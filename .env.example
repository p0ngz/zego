# Copy to .env and adjust. `docker compose up -d db` serves the database below.

NODE_ENV=development

# --- API ---
PORT=3003

# Matches docker-compose.yml. Port 5440 on the host, 5432 inside the container.
DATABASE_URL=postgresql://zego:zego@localhost:5440/zego?schema=public

# Browser origins allowed to call the API, comma separated.
CORS_ORIGINS=http://localhost:3002

# Encrypts the national ID number at rest — required when NODE_ENV=production.
# Generate one with:  openssl rand -base64 32
APP_ENCRYPTION_KEY=

# Applications accepted per IP address per hour.
SUBMIT_RATE_LIMIT=10

# --- Web ---
VITE_API_URL=http://localhost:3003
